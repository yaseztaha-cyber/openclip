# OpenClip Backend Configuration
# Copy this file to .env and fill in your values

# Directory for temporary video/clip files
TMP_DIR=./tmp

# SQLite database path
DB_PATH=./data/openclip.db

# CORS origin (frontend URL)
CORS_ORIGIN=http://localhost:3000

# ============================================
# Automation hub (all optional; safe defaults)
# ============================================
# dry_run | live — dry run never publishes, submits, or sends live mail
AUTOMATION_MODE=dry_run
# Live publishing requires this PLUS an explicit approval id per publish
LIVE_PUBLISHING_ENABLED=false
# Human approval gate before any publish
HUMAN_APPROVAL_REQUIRED=true
# Per-platform publish tokens (never commit real tokens)
# PUBLISH_TOKEN_TIKTOK=
# PUBLISH_TOKEN_YOUTUBE=
# Optional explicit platform allow-list (comma-separated; empty = any)
# PUBLISH_PLATFORMS=tiktok,youtube
# Official campaign provider (authorized API only; disabled when unset)
# WHOP_API_KEY=
# WHOP_API_BASE=https://api.whop.com/api/v1
# WHOP_API_VERSION_DATE=2026-07-01
# WHOP_ACCOUNT_ID=biz_XXXXXXXXXXXXXXXX (expected account; mismatches refuse)
# Weekly report mail (unset → report stored with EMAIL NOT SENT)
# SMTP_HOST= SMTP_PORT=587 SMTP_USER= SMTP_PASS= SMTP_FROM=
# REPORT_RECIPIENTS=owner@example.com
# Approval validity window in hours (expired approvals cannot publish)
# APPROVAL_TTL_HOURS=168
# Scheduler worker lease/heartbeat in seconds
# SCHEDULER_LEASE_TTL_S=300
# SCHEDULER_HEARTBEAT_S=15
# Interactive editor transcript budget in seconds (miss renders without captions)
# EDITOR_TRANSCRIPT_TIMEOUT=90

# ============================================
# IMPORTANT: Never commit real API keys!
# Add your keys to .env (not .env.example)
# ============================================
